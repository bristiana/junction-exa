{
  "manifest_version": 3,
  "name": "Vali",
  "version": "0.1.0",
  "description": "Hand off an errand. Vali researches it with Exa in the background, shows its sources and prepares the next step for you to approve.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "contextMenus", "notifications", "alarms", "scripting", "activeTab", "tabs"],
  "host_permissions": ["https://api.exa.ai/*", "https://bogdan-c-2206--vali-web.us-east.modal.run/*", "http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Vali: hand off an errand",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "side_panel": { "default_path": "panel/panel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.google.com/*", "*://*.google.fi/*",
        "*://*.whatsapp.com/*", "*://*.messenger.com/*", "*://*.slack.com/*", "*://*.discord.com/*",
        "*://outlook.live.com/*", "*://outlook.office.com/*", "*://outlook.office365.com/*",
        "*://*.op.fi/*", "*://*.nordea.fi/*", "*://*.danskebank.fi/*", "*://*.s-pankki.fi/*", "*://*.aktia.fi/*",
        "*://*.saastopankki.fi/*", "*://*.omasp.fi/*", "*://*.handelsbanken.fi/*"
      ],
      "js": ["content/presence.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["mascot/needs_approval.svg"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+V" }, "description": "Open Vali" }
  }
}
