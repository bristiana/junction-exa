{
  "name": "vali-desktop",
  "version": "0.1.0",
  "description": "Vali, your errand butler in Finland",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "author": "Bogdan-ca <bogdan.c.2206@gmail.com>",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "prestart": "npm run prepare",
    "start": "electron .",
    "pretest": "npm run prepare",
    "test": "node --test test/*.test.mjs",
    "icon": "node scripts/icon.mjs",
    "live-check": "npm run prepare && node scripts/live-check.mjs",
    "pack": "npm run prepare && electron-builder --mac dir",
    "dist": "npm run prepare && npm run icon && electron-builder --mac dmg",
    "talk-check": "npm run prepare && electron . --talk-check"
  },
  "devDependencies": {
    "@elevenlabs/client": "1.32.1",
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "fi.vali.desktop",
    "productName": "Vali",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "api.mjs",
      "imessage/**/*.mjs",
      "mac.mjs",
      "logic.mjs",
      "stage.mjs",
      "valet.mjs",
      "welcome.mjs",
      "bridge.cjs",
      "renderer/**/*",
      "vendor/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Vali listens while you hold the talk shortcut or press the microphone, so you can say your errand.",
        "NSAppleEventsUsageDescription": "Vali controls Messages to reply to linked iMessage senders when the iMessage bridge is enabled. Vali also reads the browser tab and copies selected text when you ask about it."
      }
    },
    "dmg": {
      "title": "Vali"
    }
  }
}
